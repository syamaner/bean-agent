<Project Sdk="Aspire.AppHost.Sdk/13.0.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>2959a3f1-6267-449a-afb0-7c199cb7057c</UserSecretsId>
    <NoWarn>$(NoWarn);ASPIREHOSTINGPYTHON001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire.Hosting.AppHost is now included automatically by the SDK -->
    <PackageReference Include="Aspire.Hosting.Python" Version="13.0.0" />
  </ItemGroup>

</Project>
